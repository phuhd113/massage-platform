NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=massage
DB_PASSWORD=massage_dev_pw
DB_NAME=massage_platform

REDIS_HOST=localhost
REDIS_PORT=6379

# Bắt buộc đổi ở production. Không commit giá trị thật vào git.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Stub OTP: khi true, mã OTP được trả về trong response dev + ghi log thay vì gửi SMS thật.
# Ở production phải đặt false và cắm adapter SMS thật (eSMS/SpeedSMS).
OTP_STUB_ENABLED=true
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=5
