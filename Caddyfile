# Reverse proxy + TLS tự động cho masgo.vn.
#
# Caddy tự xin và gia hạn chứng chỉ Let's Encrypt qua thử thách HTTP-01 trên cổng 80.
# Điều kiện: DNS đã trỏ về IP này **và** cổng 80 mở ra internet.
#
# Nếu DNS ở Cloudflare đang bật chế độ Proxy (đám mây cam), thử thách HTTP-01 vẫn đi
# qua được, nhưng lúc đó Cloudflare mới là bên trình chứng chỉ cho khách và SSL/TLS mode
# **bắt buộc** phải là "Full (strict)" — xem docs/deploy-vps.md mục DNS.

{
	email {$ACME_EMAIL}

	# Bỏ comment dòng dưới trong lúc thử nghiệm. Let's Encrypt chỉ cho **5 chứng chỉ
	# trùng tên miền mỗi 7 ngày**, và một cấu hình DNS sai lặp lại vài lần là hết hạn
	# mức — kẹt không có HTTPS nhiều ngày, thường đúng lúc đang cần sửa gấp.
	#
	# Chứng chỉ staging bị trình duyệt báo không tin cậy; đó là điều bình thường và là
	# cách nhận ra mình đang chạy staging. Nhớ bỏ nó đi (và `docker compose restart caddy`)
	# trước khi mở cho khách thật.
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# Đoạn dùng chung cho cả ba host.
(common) {
	# Nén: trang khu vực có nhiều HTML lặp lại nên tỉ lệ nén rất cao.
	encode zstd gzip

	header {
		# HSTS. **Cân nhắc kỹ trước khi thêm `preload`**: nó không rút lại được nhanh, và
		# một lần cấu hình TLS sai sau đó nghĩa là trình duyệt từ chối vào site. Trong
		# tuần đầu có thể hạ max-age xuống 3600 để còn lùi được nếu có gì sai.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		# Không để trình duyệt tự đoán kiểu file: một file khách upload bị đoán thành
		# HTML là đường XSS lưu trữ.
		X-Content-Type-Options nosniff

		# Chặn nhúng site vào iframe của bên khác (clickjacking).
		X-Frame-Options SAMEORIGIN

		Referrer-Policy strict-origin-when-cross-origin

		# Không quảng cáo phiên bản server.
		-Server
	}

	# Access log. **Caddy mặc định KHÔNG ghi request thành công** — chỉ lỗi và ACME —
	# nên trước khi có khối này, lưu lượng trang chủ / trang khu vực / trang dịch vụ
	# không để lại dấu vết nào. Đã đo trước khi thêm: 41 dòng trong 24 giờ, toàn bộ là
	# ACME và warning.
	#
	# Đây là nguồn **duy nhất** thấy được Googlebot: GA4 không đếm bot, và
	# `analytics_events` chỉ ghi sự kiện gắn với một KTV cụ thể (cột `ktv_id` NOT NULL)
	# nên một lượt vào trang chủ rồi thoát không sinh dòng nào ở đâu cả.
	log {
		output file /var/log/caddy/access.log {
			# **Bắt buộc có xoay vòng.** VPS 4GB / 45GB đĩa, và thứ chết trước khi đĩa
			# đầy là Postgres — tức chính DB mà mọi thứ khác dựa vào. Ba số này là trần
			# cứng ~300MB, không phụ thuộc lưu lượng tăng bao nhiêu.
			roll_size 30MiB
			roll_keep 10
			roll_keep_for 720h
		}

		# JSON để `jq` đọc được. `console` dễ nhìn bằng mắt hơn nhưng phải parse bằng
		# regex, và tools/traffic-report.sh cần trích từng trường.
		format filter {
			wrap json

			# IP khách **băm**, không ghi thô. Hai lý do, lý do thứ hai mới là ràng buộc
			# thật: (1) IP là dữ liệu cá nhân theo Nghị định 13; (2) mục 8 của
			# /chinh-sach-bao-mat khai rõ phạm vi lưu IP là "khi bạn bấm liên hệ hoặc báo
			# cáo" — access log ghi IP thô của **mọi** request rộng hơn hẳn lời đã khai,
			# tức biến trang chính sách thành một lời khai sai.
			#
			# Băm vẫn giữ nguyên giá trị đếm: cùng một khách cho cùng một chuỗi trong
			# ngày, nên vẫn tính được số khách phân biệt. Thứ mất đi chỉ là khả năng lần
			# ngược ra một người cụ thể — thứ không dùng tới ở đây.
			request>remote_ip hash
			request>client_ip hash

			# Cookie chứa JWT phiên. Caddy có ghi đè sẵn thành REDACTED, nhưng xoá hẳn
			# thì không phụ thuộc vào mặc định đó giữ nguyên qua các bản nâng cấp.
			request>headers>Cookie delete
			request>headers>Authorization delete

			# User-Agent phải GIỮ: đây là cách duy nhất phân biệt Googlebot với khách
			# thật, mà đó chính là câu hỏi access log sinh ra để trả lời.
			request>headers>Set-Cookie delete
		}
	}
}

# ---------------------------------------------------------------------------
# Trang web (Next.js)
{$DOMAIN} {
	import common

	# `web` là tên service trong mạng compose; Docker DNS phân giải nó.
	#
	# Caddy tự thêm X-Forwarded-For, X-Forwarded-Proto và X-Forwarded-Host — không cần
	# khai tay, và khai tay bằng `header_up X-Forwarded-For {remote_host}` sẽ **ghi đè**
	# thay vì nối thêm, tức là tự tay xoá mất chuỗi IP mà middleware phía sau cần đọc.
	reverse_proxy web:3000
}

# www -> apex, vĩnh viễn. Phục vụ cùng nội dung ở hai host là tự tạo nội dung trùng lặp,
# và canonical trong HTML luôn trỏ về NEXT_PUBLIC_SITE_URL (apex) nên bản www sẽ mâu
# thuẫn với chính nó. `permanent` để gộp link equity về một host duy nhất.
www.{$DOMAIN} {
	import common
	redir https://{$DOMAIN}{uri} permanent
}

# ---------------------------------------------------------------------------
# API
#
# Subdomain riêng, **không** phải đường dẫn /api trên masgo.vn. Đây là điều kiện để
# trình duyệt gọi thẳng vào API: nếu ghép chung host thì mọi request lead/view/report
# đi qua Next và backend chỉ thấy IP của Next — sập hết cơ chế gộp trùng, tức số liệu
# đem tính tiền sai.
#
# Đổi lại, đây là cross-origin thật, nên Cors__Origins trong docker-compose.prod.yml
# phải đúng.
{$API_DOMAIN} {
	import common

	# `/` ở đây trả 404 và đó là **đúng**: redirect `/` -> `/swagger` chỉ tồn tại ở môi
	# trường Development (Program.cs), và Swagger cố ý tắt ở Production — nó liệt kê
	# từng endpoint kèm schema, tức là bản đồ tấn công miễn phí.
	#
	# Đừng "sửa" cái 404 này bằng cách bật Swagger.
	reverse_proxy api:8080

	# Mặc định của Caddy là không giới hạn upload. Ứng dụng đã tự giới hạn 5MB cho chứng
	# chỉ và 3MB cho ảnh (UploadOptions), nhưng chặn sớm ở proxy nghĩa là một file 2GB
	# không kịp đi qua mạng nội bộ trước khi bị từ chối.
	#
	# Đây là directive của site block, KHÔNG phải subdirective của reverse_proxy —
	# đặt nhầm vào trong thì Caddy từ chối khởi động với "unrecognized subdirective".
	request_body {
		max_size 12MB
	}

	# Tuỳ chọn siết thêm: chặn hẳn dashboard Hangfire ở tầng proxy và chỉ vào qua SSH
	# tunnel. Dashboard kích chạy và **xoá** được job, kể cả job đối soát ví.
	#
	# Để dạng comment vì bật lên thì admin thật cũng không vào được — nó đã được bảo vệ
	# bằng vai ADMIN (Jobs:DashboardAnonymous mặc định false ở Production), nên đây là
	# lớp thứ hai tuỳ chọn chứ không phải lớp duy nhất.
	#
	# @hangfire path /hangfire*
	# respond @hangfire 404
}

# ---------------------------------------------------------------------------
# Giám sát hạ tầng (Beszel) — CPU/RAM/disk/uptime của VPS và từng container.
#
# Đăng nhập bằng tài khoản Beszel riêng (tạo lúc mở hub lần đầu), KHÔNG dùng chung với
# ADMIN của app — hai hệ thống auth độc lập, đừng ngộ nhận vai ADMIN của app tự có quyền
# ở đây. Không thêm bất kỳ site block nào khác kiểu này mà thiếu `import common` — thiếu
# là mất luôn HSTS/nosniff/frame-options cho đúng trang lộ số liệu hạ tầng.
status.{$DOMAIN} {
	import common
	reverse_proxy beszel:8090
}
