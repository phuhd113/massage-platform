<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Sinh file XML để Swagger hiển thị doc comment của controller/DTO.
         CS1591 tắt vì không bắt buộc mọi kiểu public phải có comment; CS1573 tắt
         vì không cần mô tả các tham số hạ tầng như CancellationToken. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.0" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.21.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NetTopologySuite" Version="8.0.11" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

<ItemGroup>
    <!-- Nhúng thay vì copy ra thư mục output: seeder chạy cả từ container đã publish
         lẫn từ dotnet test, hai nơi có working directory khác nhau. Embedded resource
         có đúng một đường tra cứu hoạt động giống nhau ở cả hai. -->
    <EmbeddedResource Include="Data\SeedData\vietnam-areas.json" />
    <EmbeddedResource Include="Data\SeedData\vietnam-area-centroids.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Massage.Wallet.Domain\Massage.Wallet.Domain.csproj" />
    <ProjectReference Include="..\Massage.Promotion.Domain\Massage.Promotion.Domain.csproj" />
  </ItemGroup>

</Project>
