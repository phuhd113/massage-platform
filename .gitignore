# Secrets & cấu hình cục bộ
.env
.env.local
.env.*.local

# Ngoài `.env` ở trên: `.env.production` chứa mật khẩu DB, JWT secret và secret của
# cổng thanh toán. Pattern `.env` chỉ khớp đúng tên file đó, không khớp `.env.production`.
.env.production

# Bản sao lưu .env sinh khi đổi cấu hình (vd lúc chuyển dev sang đĩa local).
# Chúng chứa nguyên credential cũ, và `.env` ở trên không khớp tên có hậu tố.
.env.bak
.env.bak.*

!.env.example
!.env.production.example
appsettings.Local.json
appsettings.*.Local.json

# File KTV upload — không bao giờ commit dữ liệu người dùng
uploads/

# Dump Postgres do tools/backup-db.sh sinh ra trên máy production. Cùng lý do với
# uploads/: đây là dữ liệu thật, và một file dump nằm trong repo là toàn bộ DB bị
# đẩy lên nơi nhiều người đọc được.
backups/
*.log

# Editor / OS
.DS_Store
Thumbs.db
