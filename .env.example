# Cloudflare R2 — nơi lưu ảnh hồ sơ KTV và file chứng chỉ.
#
# Để trống TẤT CẢ thì API tự dùng đĩa local (volume `uploads` trong docker-compose),
# tức dev và test chạy được ngay mà không cần tài khoản Cloudflare. Điền vào để bật R2.
#
# Copy file này thành `.env` ở gốc repo. `.env` KHÔNG được commit.

# Trang Cloudflare > R2 > Overview, góc phải ("Account ID").
R2_ACCOUNT_ID=

# R2 > Manage API tokens > Create API token, quyền "Object Read & Write",
# giới hạn đúng bucket bên dưới. Secret chỉ hiện đúng một lần lúc tạo.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

R2_BUCKET=massage-platform

# Origin phục vụ ảnh công khai — custom domain đã nối vào bucket
# (https://cdn.ten-mien-cua-ban.com) hoặc URL r2.dev khi bật Public Development URL.
#
# KHÔNG dùng endpoint S3 (https://<account>.r2.cloudflarestorage.com): endpoint đó chỉ
# nhận request đã ký, nên ảnh sẽ 401 mà không có lỗi nào trong log.
R2_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Zalo ZNS — gửi mã OTP đăng nhập. Hướng dẫn đầy đủ: docs/zalo-zns-setup.md
#
# Để trống thì hệ thống dùng stub: mã trả thẳng trong response và ghi log, không
# gửi tin nào. Đó là mặc định cho dev.
#
# Adapter chọn theo credential, không theo cờ riêng: có đủ AppId + SecretKey +
# TemplateId thì gửi thật. Nhưng OTP_STUB_ENABLED=true LUÔN thắng, kể cả khi đã
# điền credential — nếu không, một máy dev có .env thật sẽ gửi tin tới số thật và
# đốt quota mà không có gì báo, vì lượt gửi vẫn thành công.
OTP_STUB_ENABLED=true

# developers.zalo.me > ứng dụng của bạn.
ZALO_ZNS_APP_ID=
ZALO_ZNS_SECRET_KEY=

# Lấy qua luồng OAuth (bước 4 trong docs/zalo-zns-setup.md).
#
# Đây chỉ là HẠT GIỐNG cho lần chạy đầu tiên: Zalo xoay refresh token mỗi lần dùng
# và vô hiệu bản cũ, nên hệ thống lưu bản mới vào bảng `zalo_tokens` ở Postgres.
# Từ lượt refresh đầu tiên trở đi, giá trị ở đây không còn được đọc tới.
ZALO_ZNS_REFRESH_TOKEN=

# ID template OTP đã được Zalo duyệt.
ZALO_ZNS_TEMPLATE_ID=

# Tên tham số trong template — do chính bạn đặt lúc tạo template, nên không có giá
# trị đúng chung. Khai sai thì ZNS trả lỗi tham số chứ không gửi tin.
# Template không có tham số hạn thì để ZALO_ZNS_EXPIRY_PARAM trống.
ZALO_ZNS_CODE_PARAM=otp
ZALO_ZNS_EXPIRY_PARAM=

# true = chế độ phát triển: Zalo chỉ nhận số nằm trong danh sách test của OA và
# không trừ quota. Dùng khi template chưa được duyệt cho production.
ZALO_ZNS_DEV_MODE=false
